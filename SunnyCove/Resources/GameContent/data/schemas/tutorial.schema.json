{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tutorial",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "resumable": {
      "type": "boolean"
    },
    "interruptible": {
      "type": "boolean"
    },
    "resumeField": {
      "type": "string"
    },
    "generated": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "precondition": {
            "type": [
              "string",
              "null"
            ]
          },
          "character": {
            "enum": [
              "marina",
              "kai",
              "shelly",
              "gull"
            ]
          },
          "portrait": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "highlightUI": {
            "type": "object"
          },
          "allowedActions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "completion": {
            "type": "object",
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "id",
          "trigger",
          "character",
          "portrait",
          "text",
          "highlightUI",
          "allowedActions",
          "completion"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "resumable",
    "steps"
  ],
  "additionalProperties": true
}