{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AssetManifest",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "package": {
      "type": "string"
    },
    "generated": {
      "type": "string"
    },
    "pathBase": {
      "type": "string"
    },
    "totalAssets": {
      "type": "integer"
    },
    "byCategory": {
      "type": "object"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "category": {
            "enum": [
              "merge_item",
              "generator_state",
              "board_tile",
              "board_token",
              "character_pose",
              "ui",
              "scene",
              "scene_element",
              "appstore"
            ]
          },
          "format": {
            "type": "string"
          },
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "transparent": {
            "type": "boolean"
          },
          "purpose": {
            "type": "string"
          },
          "appName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "path",
          "category",
          "width",
          "height",
          "transparent"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "schemaVersion",
    "totalAssets",
    "assets"
  ],
  "additionalProperties": true
}